EXPO_PUBLIC_API_URL=https://api.hindenburgindia.live
EXPO_PUBLIC_WS_URL=wss://api.hindenburgindia.live
EXPO_PUBLIC_APP_NAME=Hindenburg
EXPO_PUBLIC_ENV=production

# Feature flags (see src/core/config/flags.ts). Anything other than
# 1/true/yes/on counts as off.
# Email verification — keep OFF until the backend has a mail provider
# configured, otherwise the send-code endpoint fails.
EXPO_PUBLIC_FEATURE_EMAIL_VERIFICATION=0
# OTP challenge on bank-account edits/deletes. ON by default; the client
# skips the gate automatically if the backend route isn't deployed.
EXPO_PUBLIC_FEATURE_BANK_OTP=1
